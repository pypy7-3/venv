import cv2
import numpy as np
import matplotlib.pyplot as plt

# Read grayscale image
image = cv2.imread("input.jpg", cv2.IMREAD_GRAYSCALE)

if image is None:
    raise FileNotFoundError("input.jpg not found")


# Sampling Function
def sampling(img, interval):

    # Take every nth pixel
    sampled = img[::interval, ::interval]

    return sampled


# Quantization Function
def quantization(img, levels):

    # Calculate quantization step size
    step = 256 // levels

    # Quantize image
    quantized = (img // step) * step

    return np.uint8(quantized)


# Apply Sampling
sampling_interval = 2

sampled_image = sampling(image, sampling_interval)


# Apply Quantization
levels = 4  # 2-bit quantization

quantized_image = quantization(image, levels)


