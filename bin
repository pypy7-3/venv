import numpy as np
import cv2
import matplotlib.pyplot as plt


# Noise Injection (From Scratch)
def add_sp_noise(image, prob=0.05):
    """
    Adds Salt (255) and Pepper (0) noise using pure NumPy vectorization.
    prob: The total percentage of pixels to corrupt (e.g., 0.05 = 5%)
    """
    noisy_img = np.copy(image)

    # Generate a matrix of random decimals between 0.0 and 1.0
    rand_matrix = np.random.rand(*noisy_img.shape)

    # Half the probability becomes Pepper (Black)
    noisy_img[rand_matrix < (prob / 2)] = 0

    # The other half becomes Salt (White)
    noisy_img[rand_matrix > 1 - (prob / 2)] = 255

    return noisy_img


# Setup and Execution
# Load the image in grayscale
original = cv2.imread("test.jpg", cv2.IMREAD_GRAYSCALE)

# 1. Add 5% Salt and Pepper Noise
noisy_image = add_sp_noise(original, prob=0.05)

# 2. Mean Filtering (Linear)
# Uses a 5x5 box filter that averages the surrounding pixels
mean_filtered = cv2.blur(noisy_image, (5, 5))

# 3. Median Filtering (Non-linear)
# Uses a 5x5 kernel that sorts the pixels and picks the middle value
median_filtered = cv2.medianBlur(noisy_image, 5)

# Visualization
fig, axes = plt.subplots(1, 4, figsize=(20, 5))

axes[0].imshow(original, cmap="gray")
axes[0].set_title("1. Original Image")

axes[1].imshow(noisy_image, cmap="gray")
axes[1].set_title("2. Noisy Image (5% S&P)")

axes[2].imshow(mean_filtered, cmap="gray")
axes[2].set_title("3. Mean Filtered (5x5)")

axes[3].imshow(median_filtered, cmap="gray")
axes[3].set_title("4. Median Filtered (5x5)")

for ax in axes:
    ax.axis("off")

plt.tight_layout()
plt.show()

