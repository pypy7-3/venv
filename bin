# 3. Complement and Conversion: Compute the complement of an input color image. After obtaining the complement, convert the resulting color image into a
# standard grayscale image.
import cv2
import numpy as np
import matplotlib.pyplot as plt

# 1. Load the original image
img_cv2 = cv2.imread("test.jpg")
img_rgb = cv2.cvtColor(img_cv2, cv2.COLOR_BGR2RGB)

# 2. Compute the Color Complement
# This inverts all three channels (R, G, and B) instantly
complement_color = 255 - img_rgb

# 3. Convert the Complement to Grayscale (Float-Free Average Method)
# Extract channels from the NEW complemented image, not the original!
R_comp = complement_color[:, :, 0].astype(np.int32)
G_comp = complement_color[:, :, 1].astype(np.int32)
B_comp = complement_color[:, :, 2].astype(np.int32)

complement_gray = ((R_comp + G_comp + B_comp) // 3).astype(np.uint8)

# 4. Visualization
plt.figure(figsize=(15, 5))

plt.subplot(1, 3, 1)
plt.title("Original Color")
plt.imshow(img_rgb)
plt.axis("off")

plt.subplot(1, 3, 2)
plt.title("Color Complement")
plt.imshow(complement_color)
plt.axis("off")

plt.subplot(1, 3, 3)
plt.title("Complement in Grayscale")
plt.imshow(complement_gray, cmap="gray")
plt.axis("off")

plt.show()

