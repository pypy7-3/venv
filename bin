import cv2
import numpy as np
import matplotlib.pyplot as plt

# Read grayscale image
image = cv2.imread("input.jpg", 0)

if image is None:
    raise FileNotFoundError("Image not found")


# Convert image to float
image = np.float32(image)

# Take logarithm
log_image = np.log1p(image)

# FFT
fft = np.fft.fft2(log_image)

fft_shift = np.fft.fftshift(fft)

rows, cols = image.shape

crow, ccol = rows // 2, cols // 2


# Homomorphic Filter
D0 = 30

H = np.zeros((rows, cols), np.float32)

for i in range(rows):
    for j in range(cols):
        d = np.sqrt((i - crow) ** 2 + (j - ccol) ** 2)

        H[i, j] = 1 - np.exp(-(d**2) / (2 * (D0**2)))


# Apply Filter
filtered = fft_shift * H


# Inverse FFT
inverse = np.fft.ifft2(np.fft.ifftshift(filtered))

inverse = np.real(inverse)


# Exponential
result = np.exp(inverse) - 1

# Normalize result
result = cv2.normalize(result, None, 0, 255, cv2.NORM_MINMAX)

result = np.uint8(result)


# Display
plt.figure(figsize=(10, 5))

plt.subplot(1, 2, 1)
plt.imshow(image, cmap="gray")
plt.title("Original")
plt.axis("off")

plt.subplot(1, 2, 2)
plt.imshow(result, cmap="gray")
plt.title("Homomorphic Filter")
plt.axis("off")

plt.tight_layout()
plt.show()

