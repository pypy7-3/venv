import numpy as np
from collections import deque

def path_4_connectivity(img, start, end):
    rows, cols = img.shape

    N4 = [(-1,0), (1,0), (0,-1), (0,1)]

    visited = np.zeros((rows, cols), dtype=bool)
    q = deque([start])

    visited[start] = True

    while q:
        x, y = q.popleft()

        if (x, y) == end:
            return True

        for dx, dy in N4:
            nx, ny = x + dx, y + dy

            if 0 <= nx < rows and 0 <= ny < cols:
                if not visited[nx, ny] and img[nx, ny] == 1:
                    visited[nx, ny] = True
                    q.append((nx, ny))

    return False


