import cv2
import numpy as np
import matplotlib.pyplot as plt

# Read grayscale image
image = cv2.imread("input.jpg", 0)

if image is None:
    raise FileNotFoundError("Image not found")


# FFT
f = np.fft.fft2(image)

fshift = np.fft.fftshift(f)

rows, cols = image.shape

crow, ccol = rows // 2, cols // 2


# Ideal Lowpass Filter (ILPF)
D0 = 30

ilpf = np.zeros((rows, cols), np.uint8)

for i in range(rows):
    for j in range(cols):
        d = np.sqrt((i - crow) ** 2 + (j - ccol) ** 2)

        if d <= D0:
            ilpf[i, j] = 1


# Butterworth Lowpass Filter (BLPF)
n = 2

blpf = np.zeros((rows, cols), np.float32)

for i in range(rows):
    for j in range(cols):
        d = np.sqrt((i - crow) ** 2 + (j - ccol) ** 2)

        blpf[i, j] = 1 / (1 + (d / D0) ** (2 * n))


# Gaussian Lowpass Filter (GLPF)
glpf = np.zeros((rows, cols), np.float32)

for i in range(rows):
    for j in range(cols):
        d = np.sqrt((i - crow) ** 2 + (j - ccol) ** 2)

        glpf[i, j] = np.exp(-(d**2) / (2 * (D0**2)))


# Apply Filters
ideal_result = fshift * ilpf

butter_result = fshift * blpf

gaussian_result = fshift * glpf


# Inverse FFT
ideal_img = np.fft.ifft2(np.fft.ifftshift(ideal_result))

butter_img = np.fft.ifft2(np.fft.ifftshift(butter_result))

gaussian_img = np.fft.ifft2(np.fft.ifftshift(gaussian_result))


# Magnitude
ideal_img = np.abs(ideal_img)

butter_img = np.abs(butter_img)

gaussian_img = np.abs(gaussian_img)


# Display
plt.figure(figsize=(12, 8))

plt.subplot(2, 2, 1)
plt.imshow(image, cmap="gray")
plt.title("Original")
plt.axis("off")

plt.subplot(2, 2, 2)
plt.imshow(ideal_img, cmap="gray")
plt.title("ILPF")
plt.axis("off")

plt.subplot(2, 2, 3)
plt.imshow(butter_img, cmap="gray")
plt.title("BLPF")
plt.axis("off")

plt.subplot(2, 2, 4)
plt.imshow(gaussian_img, cmap="gray")
plt.title("GLPF")
plt.axis("off")

plt.tight_layout()
plt.show()

import cv2
import numpy as np
import matplotlib.pyplot as plt

# Read grayscale image
image = cv2.imread("input.jpg", 0)

if image is None:
    raise FileNotFoundError("Image not found")


# FFT
fft = np.fft.fft2(image)

fft_shift = np.fft.fftshift(fft)

rows, cols = image.shape

crow, ccol = rows // 2, cols // 2


# Ideal Highpass Filter (IHPF)
D0 = 30

ihpf = np.ones((rows, cols), np.uint8)

for i in range(rows):
    for j in range(cols):
        d = np.sqrt((i - crow) ** 2 + (j - ccol) ** 2)

        if d <= D0:
            ihpf[i, j] = 0


# Butterworth Highpass Filter (BHPF)
n = 2

bhpf = np.zeros((rows, cols), np.float32)

for i in range(rows):
    for j in range(cols):
        d = np.sqrt((i - crow) ** 2 + (j - ccol) ** 2)

        if d == 0:
            bhpf[i, j] = 0
        else:
            bhpf[i, j] = 1 / (1 + (D0 / d) ** (2 * n))


# Apply Filters
ideal_result = fft_shift * ihpf

butter_result = fft_shift * bhpf


# Inverse FFT
ideal_image = np.fft.ifft2(np.fft.ifftshift(ideal_result))

butter_image = np.fft.ifft2(np.fft.ifftshift(butter_result))


# Magnitude
ideal_image = np.abs(ideal_image)

butter_image = np.abs(butter_image)


# High-Boost Filtering
blur = cv2.GaussianBlur(image, (5, 5), 0)

mask = image - blur

A = 1.5

high_boost = image + A * mask

high_boost = np.clip(high_boost, 0, 255)

high_boost = np.uint8(high_boost)


# Display
plt.figure(figsize=(12, 8))

plt.subplot(2, 2, 1)
plt.imshow(image, cmap="gray")
